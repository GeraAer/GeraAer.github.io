[{"content":"\u003cscript\u003edocument.addEventListener('DOMContentLoaded',()=\u003e{document.body.classList.add('lastrip-page','game-themed')})\u003c/script\u003e\n\u003cstyle\u003e\nbody.lastrip-page{\n  --l-bg:#0e1520; --l-panel:rgba(16,22,34,.9); --l-text:#e8eef8; --l-muted:#a7b4c8;\n  --l-ice:#8ec5ff; --l-rose:#ff8fab;\n  --text-color:var(--l-text); --text-secondary-color:var(--l-muted); --text-link-color:var(--l-ice);\n  --primary-color:var(--l-ice); --background-color:var(--l-bg);\n  background:\n    linear-gradient(180deg, rgba(8,12,20,.55), rgba(8,12,20,.88)),\n    url(\"/images/lastrip/shanghai.png\") center / cover fixed !important;\n  color: var(--l-text) !important;\n}\nbody.lastrip-page #profileHeader .navbar{ background: rgba(10,14,22,.8) !important; border-bottom:1px solid rgba(142,197,255,.2) !important; }\nbody.lastrip-page .navbar-brand, body.lastrip-page .nav-link{ color:#dce8f8 !important; }\nbody.lastrip-page #single, body.lastrip-page .page-content{\n  background: var(--l-panel); border:1px solid rgba(142,197,255,.22);\n  border-radius: 20px; box-shadow: 0 22px 50px rgba(0,0,0,.45); padding:1.5rem 1.7rem 2rem;\n}\nbody.lastrip-page h1, body.lastrip-page h2, body.lastrip-page h3, body.lastrip-page #single .title h1{ color: var(--l-ice) !important; }\nbody.lastrip-page a{ color: var(--l-rose) !important; }\nbody.lastrip-page .featured-image img{ border-radius:16px; max-height:380px; width:100%; object-fit:cover; border:1px solid rgba(142,197,255,.3); }\nbody.lastrip-page .ls-shot{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:1.2rem 0; }\nbody.lastrip-page .ls-shot img{ width:100%; border-radius:14px; aspect-ratio:16/10; object-fit:cover; border:1px solid rgba(255,143,171,.25); }\nbody.lastrip-page .ls-studio{ display:inline-block; padding:.35rem .9rem; border-radius:999px; margin-bottom:.8rem; background: rgba(255,143,171,.15); border:1px solid rgba(255,143,171,.4); color: var(--l-rose); font-weight:600; }\n@media(max-width:800px){ body.lastrip-page .ls-shot{ grid-template-columns:1fr; } }\n\u003c/style\u003e\n\u003cp class=\"ls-studio\"\u003eA Mayflare Magic studio title · Mayflare is a studio member\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePost-apocalyptic yuri road-trip visual novel\u003c/strong\u003e (Ren\u0026rsquo;Py).\u003c/p\u003e\n\u003cp\u003eAfter meteor fall and nuclear winter, snowbound Shanghai. Ordinary girl \u003cstrong\u003eXiaomei\u003c/strong\u003e and Danish vampire \u003cstrong\u003eXianya\u003c/strong\u003e drive toward the Shexian safe zone — drawing closer across a long, dangerous highway.\u003c/p\u003e\n\u003cp\u003eQuiet, restrained, emotional; survival and scarcity underneath.\u003c/p\u003e\n\u003cdiv class=\"ls-shot\"\u003e\n  \u003cimg src=\"/images/lastrip/frozen-sea.png\" alt=\"Frozen Shanghai\"\u003e\n  \u003cimg src=\"/images/lastrip/cg.png\" alt=\"Lastrip CG\"\u003e\n\u003c/div\u003e\n\u003ch2 id=\"status\"\u003eStatus\u003c/h2\u003e\n\u003cp\u003eIn progress. Final script largely complete; polishing presentation and release prep.\u003c/p\u003e\n\u003ch2 id=\"keywords\"\u003eKeywords\u003c/h2\u003e\n\u003cp\u003eYuri · Road Trip · Survival · Mayflare Magic\u003c/p\u003e\n","description":"A Mayflare Magic studio yuri road-trip VN. Snowbound Shanghai to Shexian — Xiaomei and vampire Xianya grow closer on a long, dangerous journey.","image":"/images/covers/lastrip.png","permalink":"https://geraaer.github.io/en/games/lastrip/","title":"Lastrip"},{"content":"\u003cscript\u003edocument.addEventListener('DOMContentLoaded',()=\u003e{document.body.classList.add('ruri-page','game-themed')})\u003c/script\u003e\n\u003cstyle\u003e\nbody.ruri-page{\n  --r-bg:#1a1a2e; --r-panel:rgba(32,28,52,.88); --r-text:#f7f2ff; --r-muted:#cfc4e0;\n  --r-purple:#9966ff; --r-gold:#ffcc00;\n  --text-color:var(--r-text); --text-secondary-color:var(--r-muted); --text-link-color:var(--r-gold);\n  --primary-color:var(--r-purple); --background-color:var(--r-bg);\n  background:\n    linear-gradient(180deg, rgba(26,26,46,.72), rgba(26,26,46,.92)),\n    url(\"/images/ruri/lucabg.png\") center top / cover fixed !important;\n  color: var(--r-text) !important;\n  font-family: \"Georgia\", \"Noto Serif SC\", serif !important;\n}\nbody.ruri-page #profileHeader .navbar{ background: rgba(26,26,46,.78) !important; border-bottom:1px solid rgba(153,102,255,.25) !important; }\nbody.ruri-page .navbar-brand, body.ruri-page .nav-link{ color:#efe7ff !important; }\nbody.ruri-page #single, body.ruri-page .page-content{\n  background: var(--r-panel); border:1px solid rgba(153,102,255,.28);\n  border-radius: 22px; box-shadow: 0 20px 60px rgba(0,0,0,.45); padding: 1.6rem 1.8rem 2rem;\n}\nbody.ruri-page h1, body.ruri-page h2, body.ruri-page h3, body.ruri-page #single .title h1{ color: var(--r-gold) !important; }\nbody.ruri-page a{ color: var(--r-purple) !important; }\nbody.ruri-page .featured-image img{ border-radius: 18px; border: 2px solid rgba(255,204,0,.35); max-height: 420px; object-fit: cover; width:100%; }\nbody.ruri-page .ruri-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:1.2rem 0 1.6rem; }\nbody.ruri-page .ruri-grid img{ width:100%; aspect-ratio: 3/4; object-fit:cover; object-position:top; border-radius:14px; border:1px solid rgba(153,102,255,.35); }\nbody.ruri-page .ruri-tag{ display:inline-block; margin:0 .35rem .35rem 0; padding:.2rem .7rem; border-radius:999px; background: rgba(153,102,255,.18); color: var(--r-gold); border:1px solid rgba(255,204,0,.35); font-size:.85rem; }\n@media(max-width:800px){ body.ruri-page .ruri-grid{ grid-template-columns:1fr; } }\n\u003c/style\u003e\n\u003cp\u003e\u003cspan class=\"ruri-tag\"\u003eYuri ADV\u003c/span\u003e\u003cspan class=\"ruri-tag\"\u003eEpistolary\u003c/span\u003e\u003cspan class=\"ruri-tag\"\u003eRen'Py\u003c/span\u003e\u003cspan class=\"ruri-tag\"\u003eUnreleased\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eEpistolary multi-POV yuri ADV\u003c/strong\u003e — a glass-lit court of purple and gold.\u003c/p\u003e\n\u003cp\u003eYear two of Rujin, Ruri Empire. Young empress \u003cstrong\u003eLuca\u003c/strong\u003e, beloved general \u003cstrong\u003eNatia\u003c/strong\u003e, and rebel leader \u003cstrong\u003eIzsna\u003c/strong\u003e braid their viewpoints through letters, key choices, and branching endings of friendship, love, betrayal, and redemption.\u003c/p\u003e\n\u003cdiv class=\"ruri-grid\"\u003e\n  \u003cimg src=\"/images/ruri/luca.png\" alt=\"Luca\"\u003e\n  \u003cimg src=\"/images/ruri/natia.png\" alt=\"Natia\"\u003e\n  \u003cimg src=\"/images/ruri/iszna.png\" alt=\"Izsna\"\u003e\n\u003c/div\u003e\n\u003ch2 id=\"status\"\u003eStatus\u003c/h2\u003e\n\u003cp\u003eCore content and systems are complete; \u003cstrong\u003enot publicly released\u003c/strong\u003e yet. Chinese only for now.\u003c/p\u003e\n\u003ch2 id=\"keywords\"\u003eKeywords\u003c/h2\u003e\n\u003cp\u003eEpistolary · Court intrigue · Yuri · Multiple endings\u003c/p\u003e\n","description":"Epistolary multi-POV yuri ADV. Letters among empress, general, and rebel — power, love, and redemption. Chinese only; not released yet.","image":"/images/covers/ruri-cover.png","permalink":"https://geraaer.github.io/en/games/ruri-empress/","title":"Ruri Empress"},{"content":"\u003cscript\u003edocument.addEventListener('DOMContentLoaded',()=\u003e{document.body.classList.add('xenia-page','game-themed')})\u003c/script\u003e\n\u003cstyle\u003e\nbody.xenia-page{\n  --x-bg:#fff6e8; --x-panel:rgba(255,255,255,.86); --x-ink:#3a2a24; --x-muted:#7a5c4e; --x-candy:#ff7eb3;\n  --text-color:var(--x-ink); --text-secondary-color:var(--x-muted); --text-link-color:#e64980;\n  --primary-color:var(--x-candy); --background-color:var(--x-bg);\n  background:\n    radial-gradient(circle at 12% 18%, rgba(255,126,179,.28), transparent 40%),\n    radial-gradient(circle at 88% 12%, rgba(116,192,252,.28), transparent 42%),\n    radial-gradient(circle at 70% 85%, rgba(140,233,154,.22), transparent 45%),\n    linear-gradient(180deg, #fff9ef, #ffe8d1) !important;\n  color: var(--x-ink) !important;\n  font-family: \"Fredoka\", \"Noto Sans SC\", sans-serif !important;\n}\nbody.xenia-page #profileHeader .navbar{ background: rgba(255,249,239,.85) !important; border-bottom: 2px solid rgba(255,126,179,.25) !important; }\nbody.xenia-page .navbar-brand{ color:#d6336c !important; font-weight:700 !important; }\nbody.xenia-page .nav-link{ color:#5c4038 !important; }\nbody.xenia-page #single, body.xenia-page .page-content{\n  background: var(--x-panel); border: 3px solid #3a2a24; border-radius: 18px;\n  box-shadow: 8px 8px 0 #3a2a24; padding: 1.5rem 1.7rem 2rem;\n}\nbody.xenia-page h1, body.xenia-page h2, body.xenia-page h3, body.xenia-page #single .title h1{ color:#d6336c !important; }\nbody.xenia-page a{ color:#1971c2 !important; }\nbody.xenia-page .featured-image img{ border-radius:14px; border:3px solid #3a2a24; box-shadow: 5px 5px 0 #fcc419; max-height:340px; width:100%; object-fit:cover; }\nbody.xenia-page .xk-assets{ display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin:1.2rem 0 1.5rem; }\nbody.xenia-page .xk-assets img{ height: 110px; width:auto; filter: drop-shadow(3px 3px 0 rgba(58,42,36,.25)); }\nbody.xenia-page .xk-pill{ display:inline-block; margin:0 .3rem .4rem 0; padding:.25rem .75rem; border-radius:999px; background:#fff; border:2px solid #3a2a24; font-size:.85rem; font-weight:600; }\n\u003c/style\u003e\n\u003cp\u003e\n  \u003cspan class=\"xk-pill\"\u003eOnline SLG\u003c/span\u003e\n  \u003cspan class=\"xk-pill\"\u003ePaper / Candy\u003c/span\u003e\n  \u003cspan class=\"xk-pill\"\u003ePlayable alpha\u003c/span\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePersistent online sandbox\u003c/strong\u003e: claim land as assets, loot to grow, conquer kingdoms.\u003c/p\u003e\n\u003cp\u003eInfinite procedural chunks, rare tiles that produce automatically, affix-driven gear loops — win a war and permanently take their territory. The fantasy is rising from a small town and leaving your kingdom on the world map.\u003c/p\u003e\n\u003cdiv class=\"xk-assets\"\u003e\n  \u003cimg src=\"/images/xenia/castle.png\" alt=\"castle\"\u003e\n  \u003cimg src=\"/images/xenia/gumdrop.png\" alt=\"gumdrop\"\u003e\n  \u003cimg src=\"/images/xenia/banner.png\" alt=\"banner\"\u003e\n\u003c/div\u003e\n\u003ch2 id=\"status\"\u003eStatus\u003c/h2\u003e\n\u003cp\u003ePlayable deployment exists (early ops / closed-ish testing). Systems-first over cinematic polish.\u003c/p\u003e\n\u003ch2 id=\"keywords\"\u003eKeywords\u003c/h2\u003e\n\u003cp\u003eTerritory · Persistent world · Loot · Kingdom wars\u003c/p\u003e\n","description":"A 24/7 persistent sandbox: claim land, loot gear, wage kingdom wars — leave your mark on the map.","image":"/images/covers/xenia.jpg","permalink":"https://geraaer.github.io/en/games/xenia/","title":"Xenia Kingdom"}]
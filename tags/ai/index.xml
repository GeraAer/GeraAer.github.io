    <item>
      <title>TULIPS Café — Dual Perspective Simulation Game</title>
      <link>http://localhost:1313/games/tulips/</link>
      <pubDate>Thu, 30 Oct 2025 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/games/tulips/</guid>
      <description>&lt;script&gt;document.addEventListener(&#39;DOMContentLoaded&#39;,()=&gt;document.body.classList.add(&#39;tulips-page&#39;))&lt;/script&gt;&#xA;&lt;!-- =========================&#xA;     LOCAL PAGE STYLE (Warm Latte Theme)&#xA;     ========================= --&gt;&#xA;&lt;style&gt;&#xA;/* ======= Warm Latte Palette ======= */&#xA;body.tulips-page {&#xA;  --bg: #1b1613;&#xA;  --bg-2: #241e1a;&#xA;  --bg-3: #2c2520;&#xA;  --fg: #f1e5d0;&#xA;  --muted: #d3c3aa;&#xA;  --link: #d6aa70;&#xA;  --accent: #d3984a;&#xA;  --accent-2: #8f5b2c;&#xA;&#xA;  --text-color: var(--fg);&#xA;  --text-secondary-color: var(--muted);&#xA;  --text-link-color: var(--link);&#xA;  --primary-color: var(--accent);&#xA;  --secondary-color: var(--accent-2);&#xA;  --background-color: var(--bg);&#xA;  --secondary-background-color: var(--bg-2);&#xA;}&#xA;&#xA;html, body.tulips-page { background: var(--bg) !important; color: var(--fg) !important; }&#xA;body.tulips-page h1, body.tulips-page h2, body.tulips-page h3, body.tulips-page h4, body.tulips-page h5 {&#xA;  color: var(--accent) !important;&#xA;}&#xA;body.tulips-page a { color: var(--link) !important; }&#xA;body.tulips-page a:hover { color: var(--accent-2) !important; }&#xA;.tulips-img-center { display: block; margin: 1.2rem auto; max-width: 90%; border-radius: 10px; }&#xA;.tulips-img-row { display: flex; gap: 10px; justify-content: center; margin: 1rem 0; }&#xA;.tulips-img-row img { width: 31%; border-radius: 8px; }&#xA;&lt;/style&gt;&#xA;&lt;style&gt;&#xA;  body.{{ . }}{&#xA;    --text-color: #f1e5d0;&#xA;    --text-secondary-color: #d3c3aa;&#xA;    --text-link-color: #d6aa70;&#xA;    --primary-color: #d3984a;&#xA;    --secondary-color: #8f5b2c;&#xA;    --background-color: #1b1613;&#xA;    --secondary-background-color: #241e1a;&#xA;  }&#xA;&lt;/style&gt;&#xA;&lt;style&gt;&#xA;/* ===============================&#xA;   TULIPS — Warm Coffee 内联样式&#xA;   只作用于 body.tulips-page（避免影响全站）&#xA;   =============================== */&#xA;body.tulips-page{&#xA;  /* 调色盘（暖咖配色） */&#xA;  --bg: #14110F;           /* 深咖底色 */&#xA;  --bg-2: #1B1512;         /* 卡片/侧栏 */&#xA;  --bg-3: #221A16;         /* 更深背景 */&#xA;  --fg: #EEE4D6;           /* 奶油白主字色 */&#xA;  --muted: #CDBBA4;        /* 次要文字 */&#xA;  --link: #D7B37A;         /* 焦糖 链接 */&#xA;  --accent: #C98A4B;       /* 太妃糖 标题/主色 */&#xA;  --accent-2: #8C4B1F;     /* 焦糖深 Hover */&#xA;&#xA;  /* 映射到主题通用变量（覆盖 theme.css） */&#xA;  --text-color: var(--fg);&#xA;  --text-secondary-color: var(--muted);&#xA;  --text-link-color: var(--link);&#xA;  --primary-color: var(--accent);&#xA;  --secondary-color: var(--accent-2);&#xA;  --background-color: var(--bg);&#xA;  --secondary-background-color: var(--bg-2);&#xA;}&#xA;&#xA;/* 页面背景 &amp; 文字基色 */&#xA;html, body.tulips-page{ background: var(--bg) !important; }&#xA;body.tulips-page{ color: var(--fg) !important; }&#xA;&#xA;/* ===== 导航（若想仅本页变色）===== */&#xA;body.tulips-page header,&#xA;body.tulips-page .navbar,&#xA;body.tulips-page nav.navbar{&#xA;  background: linear-gradient(180deg,#17120F 0%, #120E0C 100%) !important;&#xA;  border-bottom: 1px solid #2A201B !important;&#xA;}&#xA;body.tulips-page .navbar a,&#xA;body.tulips-page .navbar .nav-link,&#xA;body.tulips-page .navbar-brand{&#xA;  color: var(--link) !important;&#xA;}&#xA;body.tulips-page .navbar a:hover,&#xA;body.tulips-page .navbar .nav-link:hover{&#xA;  color: var(--accent-2) !important;&#xA;}&#xA;&#xA;/* ===== 标题颜色（强覆盖以防主题蓝盖掉） ===== */&#xA;body.tulips-page #single .title h1,&#xA;body.tulips-page #single .title h1 a,&#xA;body.tulips-page .post-title,&#xA;body.tulips-page .post-title a{&#xA;  color: var(--accent) !important;&#xA;  -webkit-text-fill-color: var(--accent) !important;&#xA;  text-shadow: none !important;&#xA;  text-decoration: none !important;&#xA;}&#xA;body.tulips-page #single .page-content h2,&#xA;body.tulips-page #single .page-content h3,&#xA;body.tulips-page #single .page-content h4,&#xA;body.tulips-page #single .page-content h5,&#xA;body.tulips-page #single .page-content h6{&#xA;  color: var(--accent) !important;&#xA;}&#xA;body.tulips-page #single .page-content h2 a,&#xA;body.tulips-page #single .page-content h3 a{&#xA;  color: var(--accent) !important; text-decoration:none !important;&#xA;}&#xA;body.tulips-page #single .page-content h2 a:hover,&#xA;body.tulips-page #single .page-content h3 a:hover{&#xA;  color: var(--accent-2) !important;&#xA;}&#xA;&#xA;/* ===== 链接 ===== */&#xA;body.tulips-page a{ color: var(--link) !important; }&#xA;body.tulips-page a:hover{ color: var(--accent-2) !important; }&#xA;&#xA;/* ===== 折叠块（fold shortcode）===== */&#xA;body.tulips-page details.fold-block{&#xA;  background: var(--bg-2); border:1px solid #2A201B; border-radius:12px; padding:.5rem .9rem;&#xA;}&#xA;body.tulips-page details.fold-block summary{&#xA;  color: var(--link); cursor:pointer; font-weight:600;&#xA;}&#xA;body.tulips-page details.fold-block[open] summary{ color: var(--accent); }&#xA;&#xA;/* ===== 代码块 / 行内代码 ===== */&#xA;body.tulips-page pre, body.tulips-page code{&#xA;  background:#100C0A !important; color:#F2E9DC !important;&#xA;  border:1px solid #2A201B !important;&#xA;}&#xA;body.tulips-page pre{&#xA;  border-radius:10px; padding:12px 14px; overflow:auto;&#xA;}&#xA;&#xA;/* ===== 表格（可读对比）===== */&#xA;body.tulips-page table{ width:100%; border-collapse:collapse; background:var(--bg-2) !important; }&#xA;body.tulips-page thead th{&#xA;  background:#2A211D !important; color:var(--fg) !important;&#xA;  border-bottom:2px solid #3A2E28 !important;&#xA;}&#xA;body.tulips-page td, body.tulips-page th{&#xA;  border:1px solid #3A2E28 !important; padding:.65rem .8rem;&#xA;}&#xA;body.tulips-page tbody tr:nth-child(odd){ background:#1C1613; }&#xA;body.tulips-page tbody tr:hover{ background:#251D19; }&#xA;&#xA;/* ===== 右侧 TOC / Tags / 侧栏卡片 ===== */&#xA;body.tulips-page .card, body.tulips-page .widget,&#xA;body.tulips-page .toc, body.tulips-page nav#TableOfContents,&#xA;body.tulips-page .table-of-contents, body.tulips-page .sidebar{&#xA;  background: var(--bg-2) !important; color: var(--fg) !important;&#xA;  border: 1px solid #2A201B !important; border-radius:12px; box-shadow:none !important;&#xA;}&#xA;body.tulips-page .toc a, body.tulips-page nav#TableOfContents a{ color: var(--link) !important; }&#xA;body.tulips-page .toc a:hover, body.tulips-page nav#TableOfContents a:hover{ color: var(--accent-2) !important; }&#xA;&#xA;/* Tag 链接（徽章/文字） */&#xA;body.tulips-page .tags a, body.tulips-page .tag-cloud a, body.tulips-page .widget-tags a{&#xA;  color: var(--link) !important; text-decoration:none !important; border-bottom:1px solid transparent;&#xA;}&#xA;body.tulips-page .tags a:hover, body.tulips-page .tag-cloud a:hover{ color: var(--accent-2) !important; border-color: var(--accent-2) !important; }&#xA;body.tulips-page .tags .badge, body.tulips-page .tag-cloud .badge{&#xA;  background:var(--bg-2) !important; color:var(--link) !important; border:1px solid #3A2E28 !important;&#xA;}&#xA;&#xA;/* ===== 按钮 ===== */&#xA;body.tulips-page .btn, body.tulips-page .btn-primary, body.tulips-page a.btn{&#xA;  background: var(--accent) !important; color:#fff !important; border:1px solid #3A2E28 !important;&#xA;}&#xA;body.tulips-page .btn:hover, body.tulips-page .btn-primary:hover{ background: var(--accent-2) !important; }&#xA;&#xA;/* ===== Mermaid（暗色 &amp; 标签/边标签可读）===== */&#xA;.tulips-page .mermaid{&#xA;  background: var(--bg-3) !important; border:1px solid #3A2E28 !important; border-radius:12px; padding:12px;&#xA;}&#xA;.tulips-page .mermaid svg{ color: var(--fg) !important; }&#xA;.tulips-page .mermaid .label,&#xA;.tulips-page .mermaid .label text,&#xA;.tulips-page .mermaid text{ fill: var(--fg) !important; }&#xA;.tulips-page .mermaid .node rect,&#xA;.tulips-page .mermaid .node circle,&#xA;.tulips-page .mermaid .node polygon,&#xA;.tulips-page .mermaid .node path{&#xA;  fill:#1B1512 !important; stroke:#C98A4B !important; stroke-width:1.4px;&#xA;}&#xA;.tulips-page .mermaid .edgePath path.path{ stroke:#C98A4B !important; }&#xA;.tulips-page .mermaid .edgeLabel rect{&#xA;  fill:#1B1512 !important; stroke:#C98A4B !important; rx:6; ry:6;&#xA;}&#xA;/* 让 edgeLabel 的 “Yes/No” 文本也显白 */&#xA;.tulips-page .mermaid .edgeLabel tspan{ fill: var(--fg) !important; }&#xA;&#xA;/* ===== 可选：全景背景（如需） ===== */&#xA;body.tulips-page.bg-panorama{&#xA;  background:&#xA;    linear-gradient(rgba(20,17,15,.35), rgba(20,17,15,.35)) fixed,&#xA;    url(&#34;{{ .Params.bgPanorama }}&#34;) center top / cover no-repeat fixed,&#xA;    var(--bg);&#xA;  background-attachment: fixed, fixed, scroll;&#xA;}&#xA;body.tulips-page.bg-panorama #single{&#xA;  max-width: 1200px; margin: 0 auto;&#xA;  background: rgba(20,17,15,.92); padding: 2rem; border-radius:16px;&#xA;  box-shadow: 0 0 40px rgba(0,0,0,.55);&#xA;}&#xA;@media (max-width: 1200px){&#xA;  body.tulips-page.bg-panorama #single{ border-radius:0; padding:1.25rem; }&#xA;}&#xA;&lt;/style&gt;&#xA;&lt;h1 id=&#34;tulips-café&#34;&gt;TULIPS Café&lt;/h1&gt;&#xA;&lt;p&gt;&lt;em&gt;A magical dual-perspective café simulation.&lt;/em&gt;&lt;/p&gt;</description>
    </item>

<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Design on Jessica·Morningstar</title><link>https://geraaer.github.io/categories/design/</link><description>Recent content in Design on Jessica·Morningstar</description><generator>Hugo</generator><language>zh-cn</language><lastBuildDate>Thu, 30 Oct 2025 00:00:00 +0000</lastBuildDate><atom:link href="https://geraaer.github.io/categories/design/index.xml" rel="self" type="application/rss+xml"/><item><title>TULIPS Café — Dual Perspective Simulation Game</title><link>https://geraaer.github.io/games/tulips/</link><pubDate>Thu, 30 Oct 2025 00:00:00 +0000</pubDate><guid>https://geraaer.github.io/games/tulips/</guid><description>&lt;script>document.addEventListener('DOMContentLoaded',()=>document.body.classList.add('tulips-page'))&lt;/script>
&lt;!-- =========================
 LOCAL PAGE STYLE (Warm Latte Theme)
 ========================= -->
&lt;style>
/* ======= Warm Latte Palette ======= */
body.tulips-page {
 --bg: #1b1613;
 --bg-2: #241e1a;
 --bg-3: #2c2520;
 --fg: #f1e5d0;
 --muted: #d3c3aa;
 --link: #d6aa70;
 --accent: #d3984a;
 --accent-2: #8f5b2c;

 --text-color: var(--fg);
 --text-secondary-color: var(--muted);
 --text-link-color: var(--link);
 --primary-color: var(--accent);
 --secondary-color: var(--accent-2);
 --background-color: var(--bg);
 --secondary-background-color: var(--bg-2);
}

html, body.tulips-page { background: var(--bg) !important; color: var(--fg) !important; }
body.tulips-page h1, body.tulips-page h2, body.tulips-page h3, body.tulips-page h4, body.tulips-page h5 {
 color: var(--accent) !important;
}
body.tulips-page a { color: var(--link) !important; }
body.tulips-page a:hover { color: var(--accent-2) !important; }
.tulips-img-center { display: block; margin: 1.2rem auto; max-width: 90%; border-radius: 10px; }
.tulips-img-row { display: flex; gap: 10px; justify-content: center; margin: 1rem 0; }
.tulips-img-row img { width: 31%; border-radius: 8px; }
&lt;/style>
&lt;style>
 body.{{ . }}{
 --text-color: #f1e5d0;
 --text-secondary-color: #d3c3aa;
 --text-link-color: #d6aa70;
 --primary-color: #d3984a;
